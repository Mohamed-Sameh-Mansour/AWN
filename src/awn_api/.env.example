# Blind Assistance API Environment Configuration
# Copy this file to .env and fill in the actual values

# ===== Google Generative AI =====
# Required for scene description and advanced object analysis
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Azure OCR =====
# Required for advanced text extraction with Azure Computer Vision
# Get your key and endpoint from: https://portal.azure.com
AZURE_OCR_KEY=your_azure_ocr_key_here
AZURE_OCR_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# ===== Optional: API Configuration =====
# Uncomment and modify if you want to override defaults from app/config.py

# DEBUG=True
# HOST=0.0.0.0
# PORT=8000

# ===== Optional: Model Confidence Thresholds =====
# Range: 0.0 to 1.0 (higher = more strict)
# CURRENCY_CONFIDENCE_THRESHOLD=0.5
# OBJECT_CONFIDENCE_THRESHOLD=0.5
# OCR_CONFIDENCE_THRESHOLD=0.6

# ===== Optional: Image Processing =====
# MAX_IMAGE_SIZE in bytes (default: 10MB = 10485760)
# MAX_IMAGE_SIZE=10485760
