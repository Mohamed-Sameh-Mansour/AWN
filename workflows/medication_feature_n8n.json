      "parameters": {
        "jsCode": "const text = $input.first().json.text;\n\n// تقسيم النص حسب السطور\nconst lines = text.split('\\n');\n\n// استخراج القيم\nconst drugName = lines[0].replace('اسم الدواء باللغة العربية:', '').trim();\nconst pros = lines[1].replace('المميزات:', '').trim();\nconst sideEffects = lines[2].replace('الآثار الجانبية:', '').trim();\nconst cons = lines[3].replace('العيوب:', '').trim();\n\nreturn [\n  {\n    json: {\n      drug_name_ar: drugName,\n      pros: pros,\n      side_effects: sideEffects,\n      cons: cons\n    }\n  }\n];\n"
      },
